# Copy to deploy/.env and replace every replace-* value before startup.
COMPOSE_PROJECT_NAME=renzai
RENZAI_HTTP_BIND=127.0.0.1
RENZAI_HTTP_PORT=8080
RENZAI_GRAFANA_BIND=127.0.0.1
RENZAI_GRAFANA_PORT=3001

POSTGRES_DB=renzai
POSTGRES_USER=renzai
POSTGRES_PASSWORD=replace-with-a-long-random-alphanumeric-database-password
RENZAI_DATABASE_URL=postgresql+asyncpg://renzai:replace-with-url-encoded-password@postgres:5432/renzai
RENZAI_DATABASE_POOL_SIZE=5
RENZAI_DATABASE_MAX_OVERFLOW=5
RENZAI_REDIS_URL=redis://redis:6379/0
RENZAI_REDIS_REQUIRED_FOR_READINESS=true

RENZAI_APP_ENVIRONMENT=production
RENZAI_APP_DEBUG=false
RENZAI_APP_PUBLIC_BASE_URL=https://renzai.example
RENZAI_APP_TRUSTED_PROXIES=["172.16.0.0/12"]
RENZAI_FORWARDED_ALLOW_IPS=172.16.0.0/12
RENZAI_APP_EXPOSE_DOCS=false
RENZAI_APP_MAX_JSON_BODY_BYTES=262144
RENZAI_CORS_ORIGINS=["https://renzai.example"]
RENZAI_CORS_ALLOW_CREDENTIALS=true

RENZAI_LOGGING_LEVEL=INFO
RENZAI_LOGGING_JSON=true
RENZAI_SESSION_VERIFIER_KEY=replace-with-a-distinct-random-session-verifier-root
RENZAI_SESSION_VERIFIER_KEY_ID=v1
RENZAI_SESSION_SECURE_COOKIE=true
RENZAI_APPLICATION_KEY_VERIFIER_KEY=replace-with-a-distinct-random-application-key-root
RENZAI_APPLICATION_KEY_VERIFIER_KEY_ID=v1
RENZAI_PROVIDER_CREDENTIAL_ACTIVE_KEY_ID=v1
RENZAI_PROVIDER_CREDENTIAL_KEYS={"v1":"replace-with-a-distinct-random-provider-encryption-root"}
RENZAI_OUTBOUND_TRUSTED_LOCAL_PROVIDER_HOSTS=[]
RENZAI_FEATURE_FLAGS_UNSAFE_INSPECTION_OVERRIDE=false
RENZAI_CELERY_TASK_ALWAYS_EAGER=false

RENZAI_OBSERVABILITY_METRICS_ENABLED=true
RENZAI_OBSERVABILITY_METRICS_PATH=/metrics
RENZAI_OBSERVABILITY_TRACING_ENABLED=false
RENZAI_OBSERVABILITY_SERVICE_NAME=renzai-api
RENZAI_OBSERVABILITY_OTLP_TRACES_ENDPOINT=http://otel-collector:4318/v1/traces
RENZAI_OBSERVABILITY_TRACE_SAMPLE_RATIO=0.05
RENZAI_OBSERVABILITY_WORKER_METRICS_PORT=9108

GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=replace-with-a-long-random-grafana-password
GF_USERS_ALLOW_SIGN_UP=false
