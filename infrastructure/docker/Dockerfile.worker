# syntax=docker/dockerfile:1.7
FROM python:3.13.9-slim-bookworm AS builder

ENV PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    VIRTUAL_ENV=/opt/venv \
    PATH=/opt/venv/bin:$PATH

RUN python -m venv "$VIRTUAL_ENV"
WORKDIR /build
COPY pyproject.toml requirements.lock README.md ./
COPY apps/api/src ./apps/api/src
RUN python -m pip install --upgrade pip setuptools wheel && python -m pip install --constraint requirements.lock .

FROM python:3.13.9-slim-bookworm AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/workers/src \
    PATH=/opt/venv/bin:$PATH

RUN groupadd --system --gid 10001 renzai \
    && useradd --system --uid 10001 --gid renzai --home-dir /app --shell /usr/sbin/nologin renzai
WORKDIR /app
COPY --from=builder /opt/venv /opt/venv
COPY workers/src ./workers/src
RUN chown -R renzai:renzai /app

USER 10001:10001
EXPOSE 9108
HEALTHCHECK --interval=20s --timeout=15s --start-period=20s --retries=5 \
  CMD ["celery", "-A", "renzai_worker.celery_app:celery_app", "inspect", "ping", "--timeout", "5"]

CMD ["celery", "-A", "renzai_worker.celery_app:celery_app", "worker", "--loglevel=INFO", "--pool=solo", "--concurrency=1", "--prefetch-multiplier=1", "--without-gossip", "--without-mingle"]
