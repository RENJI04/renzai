# syntax=docker/dockerfile:1.7
FROM python:3.13.9-slim-bookworm AS builder

ENV PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    VIRTUAL_ENV=/opt/venv \
    PATH=/opt/venv/bin:$PATH

RUN python -m venv "$VIRTUAL_ENV"
WORKDIR /build
COPY pyproject.toml requirements.lock README.md ./
COPY apps/api/src ./apps/api/src
RUN python -m pip install --upgrade pip setuptools wheel && python -m pip install --constraint requirements.lock .

FROM python:3.13.9-slim-bookworm AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH=/opt/venv/bin:$PATH

RUN groupadd --system --gid 10001 renzai \
    && useradd --system --uid 10001 --gid renzai --home-dir /app --shell /usr/sbin/nologin renzai
WORKDIR /app
COPY --from=builder /opt/venv /opt/venv
COPY alembic.ini ./
COPY alembic ./alembic
COPY scripts/validate_deployment_env.py scripts/seed_demo.py scripts/reset_demo.py ./scripts/
RUN chown -R renzai:renzai /app

USER 10001:10001
EXPOSE 8000
HEALTHCHECK --interval=15s --timeout=5s --start-period=20s --retries=5 \
  CMD ["python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/ready', timeout=3).read()"]

CMD ["python", "-m", "uvicorn", "renzai.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1", "--proxy-headers"]
