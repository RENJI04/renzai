# Safe local-development placeholders. Never place real credentials in this file.
RENZAI_APP_ENVIRONMENT=development
RENZAI_APP_DEBUG=false
RENZAI_APP_PUBLIC_BASE_URL=http://localhost:3000
RENZAI_DATABASE_URL=postgresql+asyncpg://renzai:replace-me@localhost:5432/renzai
RENZAI_DATABASE_POOL_SIZE=5
RENZAI_DATABASE_MAX_OVERFLOW=5
RENZAI_REDIS_URL=redis://localhost:6379/0
RENZAI_LOGGING_LEVEL=INFO
RENZAI_LOGGING_JSON=false
RENZAI_CORS_ORIGINS=["http://localhost:3000"]
RENZAI_PRIVACY_DEFAULT_MODE=REDACTED
RENZAI_RETENTION_SECURITY_DAYS=30
RENZAI_RETENTION_AUDIT_DAYS=365
RENZAI_SESSION_IDLE_MINUTES=30
RENZAI_SESSION_ABSOLUTE_HOURS=12
RENZAI_SESSION_VERIFIER_KEY=development-only-replace-this-32-byte-key
RENZAI_SESSION_VERIFIER_KEY_ID=v1
RENZAI_SESSION_SECURE_COOKIE=false
RENZAI_PASSWORD_RESET_MINUTES=30
RENZAI_EMAIL_VERIFICATION_HOURS=24
RENZAI_INVITATION_HOURS=168
RENZAI_EMAIL_VERIFICATION_REQUIRED=false
RENZAI_AUTH_RATE_LIMIT_ATTEMPTS=10
RENZAI_AUTH_RATE_LIMIT_WINDOW_SECONDS=300
RENZAI_APPLICATION_KEY_VERIFIER_KEY=development-only-application-key-root
RENZAI_APPLICATION_KEY_VERIFIER_KEY_ID=v1
RENZAI_APPLICATION_KEY_MAXIMUM_EXPIRY_DAYS=365
RENZAI_ANALYZE_MAX_TEXT_BYTES=32768
RENZAI_ANALYZE_HARD_MAX_TEXT_BYTES=131072
RENZAI_ANALYZE_RATE_LIMIT_REQUESTS=60
RENZAI_ANALYZE_RATE_LIMIT_WINDOW_SECONDS=60
RENZAI_PROVIDER_CREDENTIAL_ACTIVE_KEY_ID=development-v1
RENZAI_PROVIDER_CREDENTIAL_KEYS={"development-v1":"development-only-provider-credential-root"}
RENZAI_PROVIDER_CONNECT_TIMEOUT_SECONDS=3
RENZAI_PROVIDER_CHAT_TIMEOUT_SECONDS=30
RENZAI_PROVIDER_HEALTH_TIMEOUT_SECONDS=5
RENZAI_PROVIDER_RESPONSE_MAX_BYTES=131072
RENZAI_PROVIDER_REDIRECT_LIMIT=0
RENZAI_OUTBOUND_TRUSTED_LOCAL_PROVIDER_HOSTS=[]
RENZAI_GATEWAY_MAX_BODY_BYTES=98304
RENZAI_GATEWAY_MAX_MESSAGE_COUNT=32
RENZAI_GATEWAY_MAX_COMBINED_MESSAGE_BYTES=65536
RENZAI_GATEWAY_MAX_TOKENS=4096
RENZAI_GATEWAY_RATE_LIMIT_REQUESTS=30
RENZAI_GATEWAY_RATE_LIMIT_WINDOW_SECONDS=60
RENZAI_FEATURE_FLAGS_UNSAFE_INSPECTION_OVERRIDE=false
RENZAI_CELERY_TASK_ALWAYS_EAGER=false
