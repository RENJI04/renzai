{
  "name": "@renzai/sdk",
  "version": "0.1.0",
  "description": "Typed clients for the Renzai API v1",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint src tests",
    "format": "prettier --write src tests *.json *.js README.md",
    "format:check": "prettier --check src tests *.json *.js README.md",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.reporter=text --coverage.reporter=json-summary",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "5.0.1",
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.10.0",
    "eslint": "^9.39.5",
    "globals": "^16.5.0",
    "prettier": "^3.7.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.50.0",
    "vitest": "^5.0.1"
  }
}
